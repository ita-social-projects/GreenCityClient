{
  "compileOnSave": false,
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "downlevelIteration": true,
    "experimentalDecorators": true,
    "module": "es2020",
    "moduleResolution": "node",
    "importHelpers": true,
    "target": "ES2022",
    "typeRoots": ["node_modules/@types"],
    "lib": ["es2019", "dom"],
    "paths": {
      "@global-auth/*": ["src/app/main/component/auth/components/*"],
      "@global-core/*": ["src/app/main/component/core/*"],
      "@eco-news-models/*": ["src/app/greencity/modules/eco-news/models/*"],
      "@eco-news-service/*": ["src/app/greencity/modules/eco-news/services/*"],
      "@global-errors/*": ["src/app/main/component/errors/*"],
      "@home-models/*": ["src/app/greencity/modules/home/models/*"],
      "@shared/*": ["src/app/greencity/shared/*"],
      "@global-user/*": ["src/app/greencity/modules/user/*"],
      "@user-models/*": ["src/app/greencity/modules/user/models/*"],
      "@language-service/*": ["src/app/i18n/*"],
      "@global-models/*": ["src/app/main/model/*"],
      "@global-service/*": ["src/app/greencity/shared/service/*"],
      "@auth-service/*": ["src/app/shared/services/auth/*"],
      "@global-images/*": ["src/assets/img/*"],
      "@eco-news-images/*": ["src/assets/img/icon/econews/*"],
      "@footer-images/*": ["src/assets/img/icon/footer/*"],
      "@environment/*": ["src/environments/*"],
      "@pipe/*": ["src/app/main/pipe/*"],
      "@assets/*": ["src/assets/*"],
      "@ubs/*": ["src/app/ubs/*"],
      "path": ["./node_modules/path-browserify"]
    },
    "useDefineForClassFields": false
  },
  "angularCompilerOptions": {
    "fullTemplateTypeCheck": true,
    "strictInjectionParameters": true,
    "strictTemplates": true,
    "extendedDiagnostics": {
      "checks": {
        "invalidBananaInBox": "suppress"
      }
    }
  }
}
